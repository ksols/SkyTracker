# SkyTracker environment — copy to .env and fill in. Never commit .env.

# ── Database ────────────────────────────────────────────────
# Postgres connection string (local, Vercel/Prisma Postgres, Neon, …).
DATABASE_URL=""

# ── Auth.js v5 (Microsoft Entra ID) ─────────────────────────
AUTH_SECRET=""                              # npx auth secret
AUTH_MICROSOFT_ENTRA_ID_ID=""               # Entra app registration client id
AUTH_MICROSOFT_ENTRA_ID_SECRET=""           # Entra app registration client secret
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""           # https://login.microsoftonline.com/<tenant-id>/v2.0

# Entra group id whose members get write access (others are read-only).
SKYTRACKER_WRITERS_GROUP_ID=""

# ── Azure DevOps: as the signed-in person, no PAT ────────────
# Every ADO call (the board's create-in-ADO, the timeline's push/refresh, the Skytale.Specs reader) runs
# with the signed-in person's Entra token. The app registration «SkyTracker» holds the delegated permission
# Azure DevOps › user_impersonation; each person consents at their next sign-in (or an admin grants it once,
# see docs/superpowers/specs/2026-10-08-planning-system-design.md §3 «ADO access»).
# Local override: a token from
#   az account get-access-token --resource 499b84ac-1321-427f-aa17-267ca6975798 --query accessToken -o tsv
# It expires after about an hour. Never set it in a deployed environment.
ADO_DEV_TOKEN=""
# Owner initials → ADO identity for the discovery story's AssignedTo; unknown initials go into the story title.
SKYTRACKER_ADO_PEOPLE="THM=thm@skytale.no;KSO=kso@skytale.no;GO=go@skytale.no"

# ── Slack: the same-week notice and the weekly digest ────────
# Incoming webhook for the channel that hears when an epic turns yellow or red (spec R4, decision 7). Unset = nothing is sent.
SLACK_WEBHOOK_URL=""
# The app's public URL, for the link in the notice and the digest (e.g. https://sky-tracker-nu.vercel.app).
SKYTRACKER_URL=""
# Lets a scheduler post the weekly digest without a session: POST /api/timeline-digest with the header x-cron-secret.
CRON_SECRET=""

# PAT with iteration/team management scope. Used ONLY by the
# scripts/provision-sprints.ts admin tool to create future sprints. Not used
# by the running app.
ADO_PAT=""
